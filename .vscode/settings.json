{
  "latex-workshop.latex.autoBuild.run": "onType",
  "latex-workshop.latex.autoBuild.onSave": false,
  "latex-workshop.latex.autoBuild.interval": 250,
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/thesis",
  "latex-workshop.latex.recipe.default": "general: xelatex fast",
  "latex-workshop.latex.recipes": [
    {
      "name": "general: xelatex fast",
      "tools": [
        "general-fast"
      ]
    },
    {
      "name": "general: xelatex + biber",
      "tools": [
        "general-full"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "general-fast",
      "command": "/bin/bash",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build-latex.sh",
        "%DOC%",
        "%WORKSPACE_FOLDER%",
        "%OUTDIR%",
        "fast"
      ],
      "env": {}
    },
    {
      "name": "general-full",
      "command": "/bin/bash",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build-latex.sh",
        "%DOC%",
        "%WORKSPACE_FOLDER%",
        "%OUTDIR%",
        "full"
      ],
      "env": {}
    }
  ]
}