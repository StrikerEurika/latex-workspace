{
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.interval": 250,
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/thesis",
  "latex-workshop.latex.recipe.default": "general: xelatex + biber",
  "latex-workshop.latex.root": "%WORKSPACE_FOLDER%/src/thesis",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild": true,
  "latex-workshop.latex.refresh.pdf": true,
  "latex-workshop.latex.autoClean.run": "onFailed",
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.latex.recipes": [
    {
      "name": "general: xelatex fast",
      "tools": [
        "general-fast"
      ]
    },
    {
      "name": "general: xelatex + biber",
      "tools": [
        "general-full"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "general-fast",
      "command": "/bin/bash",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build-latex.sh",
        "%WORKSPACE_FOLDER%/src/thesis/main.tex",
        "%WORKSPACE_FOLDER%",
        "%OUTDIR%",
        "fast"
      ],
      "env": {}
    },
    {
      "name": "general-full",
      "command": "/bin/bash",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build-latex.sh",
        "%WORKSPACE_FOLDER%/src/thesis/main.tex",
        "%WORKSPACE_FOLDER%",
        "%OUTDIR%",
        "full"
      ],
      "env": {}
    }
  ]
}