@article{mojirsheibani2000,
  title    = {A kernel-based combined classification rule},
  journal  = {Statistics & Probability Letters},
  volume   = {48},
  number   = {4},
  pages    = {411-419},
  year     = {2000},
  issn     = {0167-7152},
  doi      = {https://doi.org/10.1016/S0167-7152(00)00024-9},
  url      = {https://www.sciencedirect.com/science/article/pii/S0167715200000249},
  author   = {Majid Mojirsheibani},
  keywords = {Classification rule, Bayes classifier, Kernel, Misclassification error, Shatter coefficient, Consistency},
  abstract = {This article deals with a weighted-type combined classification rule where the combining is based on a data discretization and the “weights” are determined by exponential kernels. The smoothing parameter of the kernel is estimated by a data-splitting approach. Both the mechanics and the asymptotic validity of the proposed procedure are discussed.}
}

@article{mojirsheibani200228,
  title    = {An Almost Surely Optimal Combined Classification Rule},
  journal  = {Journal of Multivariate Analysis},
  volume   = {81},
  number   = {1},
  pages    = {28-46},
  year     = {2002},
  issn     = {0047-259X},
  doi      = {https://doi.org/10.1006/jmva.2001.1990},
  url      = {https://www.sciencedirect.com/science/article/pii/S0047259X01919906},
  author   = {Majid Mojirsheibani},
  keywords = {Bayes rule, misclassification error, consistencey, Vapnik–Čhervonenkis},
  abstract = {We propose a data-based procedure for combining a number of individual classifiers in order to construct more effective classification rules. Under some regularity conditions, the resulting combined classifier turns out to be almost surely superior to each of the individual classifiers. Here, superiority means lower misclassification error rate.}
}

