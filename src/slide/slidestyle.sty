% Frame title
\setbeamertemplate{frametitle}{
    \vspace{0.22cm}
    \begin{beamercolorbox}[
        wd=\paperwidth,
        leftskip=0.55cm,
        rightskip=0.55cm,
        ht=0.45cm,
        dp=0.15cm
    ]{frametitle}
        {\Large\bfseries\color{mainblue}
        \ifnum\value{subsection}>0
            \arabic{section}.\arabic{subsection}.\ \insertframetitle
        \else
            \arabic{section}.\ \insertframetitle
        \fi}
    \end{beamercolorbox}
    \vspace{0.15cm}
}

%------------------------------------------------
% Footer lengths
%------------------------------------------------
\newlength{\footertabwidth}
\newlength{\footernumberwidth}

\setlength{\footernumberwidth}{1.15cm}
\setlength{\footertabwidth}{\dimexpr(\paperwidth-\footernumberwidth)/6\relax}

%------------------------------------------------
% Footer tab command
%------------------------------------------------
\newcommand{\footersectiontab}[3]{%
    \ifnum\value{section}=#1
        \begin{beamercolorbox}[
            wd=#2,
            ht=0.65cm,
            dp=0cm,
            center,
            sep=0pt
        ]{footer active}
            \vbox to 0.65cm{\vfil{\scriptsize\bfseries #3}\vfil}
        \end{beamercolorbox}%
    \else
        \begin{beamercolorbox}[
            wd=#2,
            ht=0.65cm,
            dp=0cm,
            center,
            sep=0pt
        ]{footer inactive}
            \vbox to 0.65cm{\vfil{\scriptsize #3}\vfil}
        \end{beamercolorbox}%
    \fi
}
%------------------------------------------------
% Regular slide header and footer
%------------------------------------------------
\newcommand{\regularslideheaderfooter}{
    \setbeamercolor{footer active}{fg=white,bg=tealactive}
    \setbeamercolor{footer inactive}{fg=white,bg=mainblue}
    \setbeamercolor{footer number}{fg=white,bg=darkgray}

    \setbeamertemplate{headline}{}

    \setbeamertemplate{footline}{%
        \hbox to \paperwidth{%
            \footersectiontab{1}{\footertabwidth}{INTRODUCTION}%
            \footersectiontab{2}{\footertabwidth}{BACKGROUND}%
            \footersectiontab{3}{\footertabwidth}{LITERATURE}%
            \footersectiontab{4}{\footertabwidth}{METHODOLOGY}%
            \footersectiontab{5}{\footertabwidth}{EXPERIMENTAL}%
            \footersectiontab{6}{\footertabwidth}{CONCLUSION}%
            \begin{beamercolorbox}[
                wd=\footernumberwidth,
                ht=0.65cm,
                dp=0cm,
                center,
                sep=0pt
            ]{footer number}
                \vbox to 0.65cm{\vfil
                    {\scriptsize\bfseries\insertframenumber/\inserttotalframenumber}
                \vfil}
            \end{beamercolorbox}%
        }%
    }
}


\newcommand{\plainslide}{
    \setbeamertemplate{headline}{}
    \setbeamertemplate{footline}{}
}

\AtBeginSection[]{
    {
    \setbeamertemplate{headline}{}
    \setbeamertemplate{footline}{}
    \begin{frame}[plain,noframenumbering]
        \vfill
        \centering
        {\Large\bfseries\color{mainblue}
        \arabic{section}.\ \insertsection}
        \vfill
    \end{frame}
    }
}

